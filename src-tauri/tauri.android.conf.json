{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build:mobile",
    "frontendDist": "../dist-mobile"
  },
  "app": {
    "windows": [
      {
        "title": "Omniweave",
        "backgroundColor": "#151618"
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF", "mimeType": "application/pdf", "role": "Viewer" },
      { "ext": ["docx"], "name": "Word", "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "role": "Viewer" },
      { "ext": ["pptx"], "name": "PowerPoint", "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation", "role": "Viewer" },
      { "ext": ["xlsx"], "name": "Excel", "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "role": "Viewer" },
      { "ext": ["hwpx"], "name": "HWPX", "mimeType": "application/hwp+zip", "role": "Viewer" },
      { "ext": ["png", "jpg", "jpeg", "webp", "gif"], "name": "Image", "mimeType": "image/*", "role": "Viewer" },
      { "ext": ["psd", "psb"], "name": "Photoshop", "mimeType": "image/vnd.adobe.photoshop", "role": "Editor" },
      { "ext": ["ai"], "name": "Illustrator", "mimeType": "application/postscript", "role": "Editor" },
      { "ext": ["ai"], "name": "Illustrator PDF", "mimeType": "application/illustrator", "role": "Editor" },
      { "ext": ["dxf"], "name": "DXF", "mimeType": "image/vnd.dxf", "role": "Editor" },
      { "ext": ["dwg"], "name": "DWG", "mimeType": "image/vnd.dwg", "role": "Editor" },
      { "ext": ["svg"], "name": "SVG", "mimeType": "image/svg+xml", "role": "Editor" },
      { "ext": ["hwp"], "name": "HWP", "mimeType": "application/x-hwp", "role": "Viewer" },
      { "ext": ["hwp"], "name": "HWP (Hancom)", "mimeType": "application/vnd.hancom.hwp", "role": "Viewer" },
      { "ext": ["hwp"], "name": "HWP (haansoft)", "mimeType": "application/haansofthwp", "role": "Viewer" },
      { "ext": ["doc"], "name": "Word 97-2003", "mimeType": "application/msword", "role": "Viewer" },
      { "ext": ["xls"], "name": "Excel 97-2003", "mimeType": "application/vnd.ms-excel", "role": "Viewer" },
      { "ext": ["ppt",  "pps"], "name": "PowerPoint 97-2003", "mimeType": "application/vnd.ms-powerpoint", "role": "Viewer" },
      { "ext": ["xlsm"], "name": "Excel (macros)", "mimeType": "application/vnd.ms-excel.sheet.macroEnabled.12", "role": "Viewer" },
      { "ext": ["ppsx"], "name": "PowerPoint Show", "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.slideshow", "role": "Viewer" },
      { "ext": ["csv"], "name": "CSV", "mimeType": "text/csv", "role": "Viewer" },
      { "ext": ["csv"], "name": "CSV (comma-separated)", "mimeType": "text/comma-separated-values", "role": "Viewer" },
      { "ext": ["epub"], "name": "EPUB", "mimeType": "application/epub+zip", "role": "Viewer" },
      { "ext": ["md",  "markdown"], "name": "Markdown", "mimeType": "text/markdown", "role": "Viewer" },
      { "ext": ["tif",  "tiff"], "name": "TIFF", "mimeType": "image/tiff", "role": "Viewer" },
      { "ext": ["heic",  "heif"], "name": "HEIC", "mimeType": "image/heic", "role": "Viewer" },
      { "ext": ["bmp"], "name": "BMP", "mimeType": "image/bmp", "role": "Viewer" },
      { "ext": ["omw"], "name": "Omniweave Workspace", "mimeType": "application/x-omniweave", "role": "Editor" }
    ]
  }
}
