# Omniweave 홈페이지 — Apache(.htaccess) 설정
# 정적 사이트용: 목록 숨김 · 404 페이지 · 압축 · 캐시 · 보안 헤더.
# 모듈이 없는 호스팅에서도 오류가 나지 않도록 모든 블록을 <IfModule>로 감쌌습니다.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

# 점(.)으로 시작하는 파일(.htaccess 등)·임시·백업 파일은 외부에서 열 수 없게 막습니다.
<FilesMatch "(^\.|\.(tmp|bak|swp|orig)$|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
# 다국어 생성용 원본(템플릿·번역 JSON·생성 스크립트)은 공개할 필요가 없습니다. 올리지 않아도 됩니다.
<IfModule mod_alias.c>
  RedirectMatch 404 /(_templates|i18n)(/|$)
  RedirectMatch 404 /build-i18n\.mjs$
</IfModule>
# README.txt는 운영 안내라 공개할 필요가 없습니다.
<Files "README.txt">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# MIME 형식
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType image/x-icon .ico
  AddCharset utf-8 .html .css .js .json .txt .webmanifest
</IfModule>

# 압축 (woff2·png·webp는 이미 압축된 형식이라 제외)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>

# 캐시: 글꼴·이미지는 오래, CSS·JS는 ?v=번호로 바꿔 배포하므로 1주, HTML·config.json은 항상 새로
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # 보안 헤더 — 이 사이트는 자기 서버의 파일만 씁니다(외부 CDN·추적 스크립트 없음).
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
  # 다른 사이트가 이 페이지를 iframe에 넣지 못하게 하려면 아래 두 줄의 #을 지우세요.
  # (도메인 "프레임 포워딩"으로 연결한 경우에는 켜면 페이지가 안 보이니 그대로 두세요.)
  # Header always set X-Frame-Options "SAMEORIGIN"
  # Header always edit Content-Security-Policy "$" "; frame-ancestors 'self'"
</IfModule>

# HTTPS로 강제 이동하려면(인증서가 준비된 경우에만) 아래 #을 지우세요.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
